<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ice_report_105_wizard_form" model="ir.ui.view">
        <field name="name">l10n_ec.ice.report105.wizard.form</field>
        <field name="model">l10n_ec.ice.report105.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporte ICE 105">
                <group>
                    <group string="Compañía">
                        <field name="company_id"/>
                    </group>
                    <group string="Periodo">
                        <field name="period_type" widget="radio"/>
                        <field name="year"/>
                        <field name="month"
                               invisible="period_type == 'year'"/>
                        <field name="week_number"
                               invisible="period_type != 'week'"
                               help="Número de semana dentro del mes (1-5)"/>
                    </group>
                </group>
                <group>
                    <group>
                        <field name="date_from" readonly="1"/>
                        <field name="date_to" readonly="1"/>
                    </group>
                </group>
                <footer>
                    <button string="Generar PDF"
                            name="action_generate_pdf"
                            type="object"
                            class="btn-primary"
                            icon="fa-file-pdf-o"/>
                    <button string="Descargar XML (SRI)"
                            name="action_download_xml"
                            type="object"
                            class="btn-secondary"
                            icon="fa-file-code-o"/>
                    <button string="Cancelar"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ice_report_105_wizard" model="ir.actions.act_window">
        <field name="name">Reporte ICE 105</field>
        <field name="res_model">l10n_ec.ice.report105.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
